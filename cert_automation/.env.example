# --- IONOS API Credentials ---
IONOS_API_KEY="your_ionos_api_key_here"
IONOS_API_SECRET="your_ionos_api_secret_here"

# --- ACME Client Settings ---
ACME_EMAIL="your_email@example.com"
ACME_SH_COMMAND="/path/to/acme.sh" # e.g., /home/certuser/.acme.sh/acme.sh

# --- SSH Deployment Credentials ---
# Used in servers.yaml via ${SSH_USER} and ${SSH_KEY_PATH} placeholders
SSH_USER="automation_user"          # Linux user on the target servers
SSH_KEY_PATH="/path/to/ssh/id_rsa"  # Local path to the private key

# --- OTC OpenStack Credentials (for ELB Automation) ---
OS_AUTH_URL="https://iam.eu-de.otc.t-systems.com/v3"
OS_USER_DOMAIN_NAME="your_os_domain_here"
OS_PROJECT_ID="your_os_project_id_here"
OS_USERNAME="your_os_username_here"
OS_PASSWORD="your_otc_password_here"

# --- General System Settings ---
RENEWAL_THRESHOLD_DAYS="40"
CERT_BASE_PATH="/tmp/certs"
ACME_HOME_DIR="/tmp/acme_home"

# --- Reporting & Logging ---
# Paths can be absolute or relative to the script directory
REPORT_FILE_PATH="reports/renewal_report.md"
LOG_FILE_PATH="logs/renewal.log"

# --- Microsoft Teams Notifications ---
# Power Automate Workflow HTTP-trigger URL (signed secret — never commit the real value).
# If unset OR the host does not resolve, notification is skipped silently.
TEAMS_WEBHOOK_URL=""
TEAMS_ENABLED="true"        # set false to disable entirely
NOTIFY_ON_SUCCESS="true"    # false = only notify on failures

# --- SSH known_hosts (optional override) ---
# Where the runtime pre-flight writes scanned host keys. Defaults to ~/.ssh/known_hosts.
# KNOWN_HOSTS_PATH="/home/certuser/.ssh/known_hosts"

# --- Pre-flight diagnostics (optional) ---
# Where `python3 main.py --preflight` writes its report. Defaults to reports/preflight_report_<ts>.md
# PREFLIGHT_REPORT_PATH="reports/preflight_report.md"

# --- GitLab CI Specific ---
# TARGET_SSH_HOSTS_GITLAB is no longer used — known_hosts is derived from servers.yaml at runtime.
